using './main.bicep'

// ============================================================================
// Hackathon Resource Group Parameters
// ============================================================================
// Copy this file to main-<teamname>.bicepparam and customize for your team

// Your team identifier (lowercase, 2-12 chars, no spaces/hyphens)
// This drives the resource group and resource names
// Examples: 'panthers', 'team1', 'aiagents'
param teamName = 'changeMe'

// Azure region for your resources
// Options: swedencentral, westeurope, eastus
param location = 'swedencentral'

// LLM Model Deployments
// Configure which models your team needs and their capacity
// Each deployment is accessible via its deploymentName in your app code
param modelDeployments = [
  {
    deploymentName: 'chat'
    modelName: 'gpt-4o-mini'
    modelVersion: '2026-03-17'
    skuName: 'GlobalStandard'
    capacity: 1
  }
]

// Optional: Override default resource names (uncomment to customize)
